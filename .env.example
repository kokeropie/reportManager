# --- Web server ---
PORT=3000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Inactivity timeout in hours (FR-2)
SESSION_HOURS=8
# Set true only when the site is served over HTTPS (cookie Secure flag + HSTS)
COOKIE_SECURE=false
# Set true when running behind a reverse proxy (IIS ARR, nginx)
TRUST_PROXY=false

# --- Encryption of stored connection passwords (FR-5) ---
# 64 hex chars = 32 bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every stored connection password unreadable.
ENCRYPTION_KEY=

# --- App database: SQL Server 2016+ (an empty database you created beforehand) ---
APP_DB_SERVER=localhost
APP_DB_PORT=1433
APP_DB_NAME=ReportServer
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_TRUST_CERT=true

# --- Running reports (all optional) ---
# Where uploaded .rdl files are stored
# REPORTS_DIR=./reports
QUERY_TIMEOUT_SECONDS=120
# Row cap for the on-screen view (FR-19)
MAX_ROWS=100000
# Row cap for CSV/XLSX exports (FR-24). Over the cap the export is refused, not cut short.
EXPORT_MAX_ROWS=500000
PAGE_SIZE=100
# Database sessions kept per report connection, and reports allowed to run at once (FR-28)
POOL_SIZE=10
MAX_CONCURRENT_RUNS=5

# --- First admin, created on first start only if no users exist ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
